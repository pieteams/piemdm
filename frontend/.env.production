ENV = 'production'

VITE_CLI_PORT = 8082
VITE_SERVER_PORT = 8882
# Same origin: the container's nginx proxies /api, /export and /uploads to the backend.
VITE_BASE_API =
VITE_FILE_API =
VITE_API_BASE_URL =
# Legacy: only read by src/utils/format.js, which nothing imports.
VITE_BASE_PATH = https://demo.example.com

VITE_HOST = 127.0.0.1
VITE_PORT = 8082
VITE_SERVER = http://localhost:8082
VITE_BASE = /

VUE_APP_CACHE_CONTROL=public, max-age=3600
